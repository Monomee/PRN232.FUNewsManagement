@page
@model FUNewsManagement_FE.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "Account Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Account Management</h2>
        <p class="text-muted mb-0">Manage system users, credentials, and access roles (Admin only).</p>
    </div>
    <button type="button" class="btn btn-primary px-3 shadow-sm" onclick="openCreateModal()">
        <i class="bi bi-person-plus-fill me-1"></i> Add New Account
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search by name or email..." onkeyup="filterAccounts()" />
                </div>
            </div>
            <div class="col-md-4">
                <select id="roleFilter" class="form-select" onchange="filterAccounts()">
                    <option value="">-- All Roles --</option>
                    <option value="1">Staff</option>
                    <option value="2">Lecturer</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="accountsTable">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Account Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Articles Created</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody id="accountsTableBody">
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div> Loading accounts...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Create / Edit Account Modal -->
<div class="modal fade" id="accountModal" tabindex="-1" aria-labelledby="accountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="accountModalLabel"><i class="bi bi-person-gear me-2"></i>Create Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="accountForm">
                    <input type="hidden" id="modalAccountId" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="modalAccountName" class="form-control" required placeholder="e.g. John Doe" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="modalAccountEmail" class="form-control" required placeholder="e.g. john@domain.org" maxlength="70" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">System Role <span class="text-danger">*</span></label>
                        <select id="modalAccountRole" class="form-select" required>
                            <option value="1">Staff (Role = 1) - Can manage news & categories</option>
                            <option value="2">Lecturer (Role = 2) - Read & Search news only</option>
                        </select>
                    </div>

                    <div class="mb-3" id="passwordGroup">
                        <label class="form-label fw-semibold" id="passwordLabel">Password <span class="text-danger">*</span></label>
                        <input type="password" id="modalAccountPassword" class="form-control" placeholder="Enter secure password" maxlength="70" />
                        <small class="text-muted" id="passwordHelp">Minimum 3 characters.</small>
                    </div>

                    <div id="modalAlert" class="alert alert-danger py-2 d-none" role="alert"></div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveAccount" onclick="saveAccount()">
                    <span id="saveSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status"></span>
                    Save Account
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="passwordModalLabel"><i class="bi bi-key-fill me-2"></i>Change Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="passwordForm">
                    <input type="hidden" id="pwdAccountId" />
                    <p class="text-muted small">Update password for account: <strong id="pwdAccountName"></strong></p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Password <span class="text-danger">*</span></label>
                        <input type="password" id="currentPassword" class="form-control" required placeholder="Enter current password" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input type="password" id="newPassword" class="form-control" required placeholder="Enter new password" minlength="3" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirm New Password <span class="text-danger">*</span></label>
                        <input type="password" id="confirmPassword" class="form-control" required placeholder="Re-enter new password" />
                    </div>

                    <div id="pwdAlert" class="alert alert-danger py-2 d-none" role="alert"></div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning px-4 fw-semibold" id="btnSavePassword" onclick="savePassword()">
                    Update Password
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-trash3-fill me-2"></i>Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-exclamation-triangle text-danger display-4 mb-3 d-block"></i>
                <h5 class="fw-bold mb-2">Delete this Account?</h5>
                <p class="text-muted mb-1">Are you sure you want to permanently remove:</p>
                <p class="fw-bold fs-6 text-dark mb-3" id="deleteAccountInfo"></p>
                <div class="alert alert-warning text-start small mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <strong>System Integrity Rule:</strong> An account cannot be deleted if it has created any news articles in the system.
                </div>
            </div>
            <div class="modal-footer bg-light justify-content-center">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete" onclick="confirmDelete()">
                    <span id="deleteSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status"></span>
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allAccounts = [];
        let accountModalInstance = null;
        let passwordModalInstance = null;
        let deleteModalInstance = null;
        let selectedDeleteId = null;

        document.addEventListener('DOMContentLoaded', () => {
            accountModalInstance = new bootstrap.Modal(document.getElementById('accountModal'));
            passwordModalInstance = new bootstrap.Modal(document.getElementById('passwordModal'));
            deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'));
            loadAccounts();
        });

        async function loadAccounts() {
            const tbody = document.getElementById('accountsTableBody');
            tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading accounts...</td></tr>`;

            try {
                const response = await apiFetch('account?$orderby=AccountId asc');
                if (response.ok) {
                    allAccounts = await response.json();
                    renderAccounts(allAccounts);
                } else {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger">Failed to load accounts. Status: ${response.status}</td></tr>`;
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger">Error connecting to server. Please ensure Backend API is running.</td></tr>`;
            }
        }

        function renderAccounts(accounts) {
            const tbody = document.getElementById('accountsTableBody');
            if (!accounts || accounts.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">No accounts found matching the criteria.</td></tr>`;
                return;
            }

            let html = '';
            accounts.forEach(a => {
                let roleBadge = '';
                if (a.accountRole === 1) {
                    roleBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-pencil-square me-1"></i>Staff</span>';
                } else if (a.accountRole === 2) {
                    roleBadge = '<span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-mortarboard me-1 text-primary"></i>Lecturer</span>';
                } else {
                    roleBadge = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-shield-lock me-1"></i>Admin</span>';
                }

                html += `
                    <tr>
                        <td class="ps-4 fw-semibold text-secondary">#${a.accountId}</td>
                        <td class="fw-semibold text-dark">${escapeHtml(a.accountName || '')}</td>
                        <td><span class="text-muted"><i class="bi bi-envelope me-1"></i>${escapeHtml(a.accountEmail || '')}</span></td>
                        <td>${roleBadge}</td>
                        <td>
                            <span class="badge bg-light text-dark border px-2 py-1">
                                <i class="bi bi-newspaper me-1"></i>${a.createdArticlesCount} articles
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Edit Account" onclick="openEditModal(${a.accountId})">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning me-1" title="Change Password" onclick="openPasswordModal(${a.accountId}, '${escapeHtml(a.accountName || '')}')">
                                <i class="bi bi-key"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Account" onclick="openDeleteModal(${a.accountId}, '${escapeHtml(a.accountName || '')}', '${escapeHtml(a.accountEmail || '')}')">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function filterAccounts() {
            const query = (document.getElementById('searchInput').value || '').trim().toLowerCase();
            const role = document.getElementById('roleFilter').value;

            const filtered = allAccounts.filter(a => {
                const matchesQuery = !query || 
                    (a.accountName && a.accountName.toLowerCase().includes(query)) ||
                    (a.accountEmail && a.accountEmail.toLowerCase().includes(query));
                
                const matchesRole = !role || (a.accountRole && a.accountRole.toString() === role);

                return matchesQuery && matchesRole;
            });

            renderAccounts(filtered);
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('roleFilter').value = '';
            renderAccounts(allAccounts);
        }

        function openCreateModal() {
            document.getElementById('accountModalLabel').innerHTML = '<i class="bi bi-person-plus-fill me-2"></i>Create New Account';
            document.getElementById('modalAccountId').value = '0';
            document.getElementById('modalAccountName').value = '';
            document.getElementById('modalAccountEmail').value = '';
            document.getElementById('modalAccountRole').value = '1';
            document.getElementById('modalAccountPassword').value = '';
            document.getElementById('passwordLabel').innerHTML = 'Password <span class="text-danger">*</span>';
            document.getElementById('passwordHelp').textContent = 'Password is required for new accounts.';
            document.getElementById('modalAccountPassword').required = true;
            document.getElementById('modalAlert').classList.add('d-none');
            accountModalInstance.show();
        }

        function openEditModal(id) {
            const account = allAccounts.find(a => a.accountId === id);
            if (!account) return;

            document.getElementById('accountModalLabel').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Edit Account';
            document.getElementById('modalAccountId').value = account.accountId;
            document.getElementById('modalAccountName').value = account.accountName || '';
            document.getElementById('modalAccountEmail').value = account.accountEmail || '';
            document.getElementById('modalAccountRole').value = (account.accountRole || 1).toString();
            document.getElementById('modalAccountPassword').value = '';
            document.getElementById('passwordLabel').innerHTML = 'New Password (Optional)';
            document.getElementById('passwordHelp').textContent = 'Leave blank to keep the current password.';
            document.getElementById('modalAccountPassword').required = false;
            document.getElementById('modalAlert').classList.add('d-none');
            accountModalInstance.show();
        }

        async function saveAccount() {
            const id = parseInt(document.getElementById('modalAccountId').value, 10);
            const name = document.getElementById('modalAccountName').value.trim();
            const email = document.getElementById('modalAccountEmail').value.trim();
            const role = parseInt(document.getElementById('modalAccountRole').value, 10);
            const password = document.getElementById('modalAccountPassword').value.trim();
            const alertEl = document.getElementById('modalAlert');

            if (!name || !email) {
                alertEl.textContent = 'Please fill in all required fields.';
                alertEl.classList.remove('d-none');
                return;
            }

            if (id === 0 && !password) {
                alertEl.textContent = 'Password is required when creating a new account.';
                alertEl.classList.remove('d-none');
                return;
            }

            const btn = document.getElementById('btnSaveAccount');
            const spinner = document.getElementById('saveSpinner');
            btn.disabled = true;
            spinner.classList.remove('d-none');
            alertEl.classList.add('d-none');

            try {
                let response;
                if (id === 0) {
                    // Create
                    response = await apiFetch('account', {
                        method: 'POST',
                        body: JSON.stringify({
                            accountName: name,
                            accountEmail: email,
                            accountRole: role,
                            accountPassword: password
                        })
                    });
                } else {
                    // Update
                    response = await apiFetch(`account/${id}`, {
                        method: 'PUT',
                        body: JSON.stringify({
                            accountName: name,
                            accountEmail: email,
                            accountRole: role,
                            accountPassword: password || null
                        })
                    });
                }

                if (response.ok) {
                    accountModalInstance.hide();
                    showToast(id === 0 ? 'Account created successfully!' : 'Account updated successfully!', 'success');
                    await loadAccounts();
                } else {
                    const err = await response.json();
                    alertEl.textContent = err.message || 'An error occurred while saving.';
                    alertEl.classList.remove('d-none');
                }
            } catch (err) {
                alertEl.textContent = 'Network or server error: ' + err.message;
                alertEl.classList.remove('d-none');
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        function openPasswordModal(id, name) {
            document.getElementById('pwdAccountId').value = id;
            document.getElementById('pwdAccountName').textContent = name;
            document.getElementById('currentPassword').value = '';
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmPassword').value = '';
            document.getElementById('pwdAlert').classList.add('d-none');
            passwordModalInstance.show();
        }

        async function savePassword() {
            const id = document.getElementById('pwdAccountId').value;
            const currentPwd = document.getElementById('currentPassword').value.trim();
            const newPwd = document.getElementById('newPassword').value.trim();
            const confirmPwd = document.getElementById('confirmPassword').value.trim();
            const alertEl = document.getElementById('pwdAlert');

            if (!currentPwd || !newPwd || !confirmPwd) {
                alertEl.textContent = 'All password fields are required.';
                alertEl.classList.remove('d-none');
                return;
            }

            if (newPwd !== confirmPwd) {
                alertEl.textContent = 'New password and confirm password do not match.';
                alertEl.classList.remove('d-none');
                return;
            }

            if (newPwd.length < 3) {
                alertEl.textContent = 'New password must be at least 3 characters.';
                alertEl.classList.remove('d-none');
                return;
            }

            alertEl.classList.add('d-none');

            try {
                const response = await apiFetch(`account/${id}/password`, {
                    method: 'PUT',
                    body: JSON.stringify({
                        currentPassword: currentPwd,
                        newPassword: newPwd,
                        confirmPassword: confirmPwd
                    })
                });

                if (response.ok) {
                    passwordModalInstance.hide();
                    showToast('Password updated successfully!', 'success');
                } else {
                    const err = await response.json();
                    alertEl.textContent = err.message || 'Failed to update password.';
                    alertEl.classList.remove('d-none');
                }
            } catch (err) {
                alertEl.textContent = 'Error: ' + err.message;
                alertEl.classList.remove('d-none');
            }
        }

        function openDeleteModal(id, name, email) {
            selectedDeleteId = id;
            document.getElementById('deleteAccountInfo').textContent = `${name} (${email})`;
            deleteModalInstance.show();
        }

        async function confirmDelete() {
            if (!selectedDeleteId) return;

            const btn = document.getElementById('btnConfirmDelete');
            const spinner = document.getElementById('deleteSpinner');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const response = await apiFetch(`account/${selectedDeleteId}`, {
                    method: 'DELETE'
                });

                deleteModalInstance.hide();

                if (response.ok || response.status === 204) {
                    showToast('Account deleted successfully!', 'success');
                    await loadAccounts();
                } else {
                    let errMsg = 'Failed to delete account.';
                    try {
                        const err = await response.json();
                        errMsg = err.message || errMsg;
                    } catch {}
                    showToast(errMsg, 'danger');
                }
            } catch (err) {
                deleteModalInstance.hide();
                showToast('Error: ' + err.message, 'danger');
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
                selectedDeleteId = null;
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}
