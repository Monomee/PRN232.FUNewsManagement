@page
@model FUNewsManagement_FE.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center my-5">
    <div class="col-md-6 text-center">
        <div class="display-1 text-danger mb-3">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2 class="fw-bold">Access Denied (403)</h2>
        <p class="text-muted mb-4">You do not have the required permission/role to access this resource.</p>
        <a asp-page="/Index" class="btn btn-primary px-4">
            <i class="bi bi-house-door me-1"></i> Return to Home
        </a>
    </div>
</div>
