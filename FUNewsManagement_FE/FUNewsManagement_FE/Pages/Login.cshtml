@page
@model FUNewsManagement_FE.Pages.LoginModel
@{
    ViewData["Title"] = "System Login - FUNews";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4 bg-gradient">
                <div class="mb-2">
                    <i class="bi bi-newspaper fs-1"></i>
                </div>
                <h4 class="fw-bold mb-0">FUNews Management</h4>
                <p class="text-white-50 small mb-0">Sign in to your authorized account</p>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center py-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Account Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" id="inputEmail" class="form-control" placeholder="name@domain.org" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" id="inputPassword" type="password" class="form-control" placeholder="Enter password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </div>
                </form>

                <!-- Demo Account Presets for Quick Testing -->
                <div class="mt-4 pt-3 border-top">
                    <p class="text-muted small fw-bold mb-2 text-uppercase">Demo Credentials:</p>
                    <div class="d-flex flex-column gap-1 small">
                        <button type="button" class="btn btn-sm btn-outline-danger text-start py-1" onclick="fillDemo('admin@FUNewsManagementSystem.org', '@@@@abc123@@@@')">
                            <strong>Admin:</strong> admin@FUNewsManagementSystem.org (@@@@abc123@@@@)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success text-start py-1" onclick="fillDemo('IsabellaDavid@FUNewsManagement.org', '@@1')">
                            <strong>Staff:</strong> IsabellaDavid@FUNewsManagementSystem.org
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info text-start py-1" onclick="fillDemo('EmmaWilliam@FUNewsManagement.org', '@@1')">
                            <strong>Lecturer:</strong> EmmaWilliam@FUNewsManagementSystem.org
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-footer text-center py-3 bg-light text-muted small">
                <a asp-page="/Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Public News Portal</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillDemo(email, pass) {
            document.getElementById('inputEmail').value = email;
            document.getElementById('inputPassword').value = pass;
        }
    </script>
}
