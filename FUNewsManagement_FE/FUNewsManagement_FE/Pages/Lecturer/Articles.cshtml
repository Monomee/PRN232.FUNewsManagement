@page
@model FUNewsManagement_FE.Pages.Lecturer.ArticlesModel
@{
    ViewData["Title"] = "News Explorer - Lecturer Portal";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0"><i class="bi bi-search text-primary me-2"></i>News Explorer</h2>
            <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-mortarboard me-1 text-primary"></i>Lecturer (Read & Search Only)</span>
        </div>
        <p class="text-muted mb-0">Browse published academic news, research breakthroughs, and campus events.</p>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="lecturerSearchInput" class="form-control border-start-0" placeholder="Search keywords across title, headline, content..." onkeyup="filterLecturerNews()" />
                </div>
            </div>
            <div class="col-md-4">
                <select id="lecturerCategoryFilter" class="form-select" onchange="filterLecturerNews()">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetLecturerFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Articles Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="lecturerArticlesTable">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Title & Summary</th>
                    <th>Category</th>
                    <th>Tags</th>
                    <th>Published Date</th>
                    <th>Author</th>
                    <th class="text-end pe-4">Details</th>
                </tr>
            </thead>
            <tbody id="lecturerArticlesBody">
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div> Loading articles...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Article Detail Modal with Top 3 Related News -->
<div class="modal fade" id="lecturerDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1" id="modalDetailCategory">Category</span>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 pt-2">
                <h3 class="fw-bold text-dark mt-2 mb-2" id="modalDetailTitle">News Title</h3>
                
                <div class="d-flex align-items-center gap-3 text-muted small mb-3 border-bottom pb-3">
                    <span><i class="bi bi-person-circle me-1"></i><span id="modalDetailAuthor">Author</span></span>
                    <span><i class="bi bi-calendar3 me-1"></i><span id="modalDetailDate">Date</span></span>
                    <span><i class="bi bi-link-45deg me-1"></i>Source: <span id="modalDetailSource">N/A</span></span>
                </div>

                <div class="p-3 bg-light rounded-3 mb-3 border-start border-primary border-4">
                    <p class="fw-semibold text-secondary mb-0 fst-italic" id="modalDetailHeadline">Headline</p>
                </div>

                <div class="article-content text-dark mb-4" id="modalDetailContent" style="white-space: pre-line; line-height: 1.7;">
                    Content...
                </div>

                <div class="mb-4" id="modalDetailTagsContainer">
                    <!-- Tags -->
                </div>

                <!-- Top 3 Related News Section -->
                <div class="border-top pt-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="bi bi-stars text-warning me-2"></i> Related Articles (Top 3 Recommendations)
                    </h5>
                    <div class="row g-3" id="modalRelatedNewsContainer">
                        <div class="col-12 text-muted small">Loading related articles...</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let lecturerArticles = [];
        let detailModalInstance = null;

        document.addEventListener('DOMContentLoaded', async () => {
            detailModalInstance = new bootstrap.Modal(document.getElementById('lecturerDetailModal'));
            await loadLecturerCategories();
            await loadLecturerNews();
        });

        async function loadLecturerCategories() {
            try {
                const response = await apiFetch('category?$orderby=CategoryName asc');
                if (response.ok) {
                    const cats = await response.json();
                    const select = document.getElementById('lecturerCategoryFilter');
                    select.innerHTML = '<option value="">-- All Categories --</option>';
                    cats.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.categoryId;
                        opt.textContent = c.categoryName;
                        select.appendChild(opt);
                    });
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function loadLecturerNews() {
            const tbody = document.getElementById('lecturerArticlesBody');
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading articles...</td></tr>`;

            try {
                // Lecturer can view active articles
                const response = await apiFetch('news?$orderby=CreatedDate desc');
                if (response.ok) {
                    lecturerArticles = await response.json();
                    renderLecturerArticles(lecturerArticles);
                } else {
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Failed to load articles.</td></tr>`;
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Error connecting to server.</td></tr>`;
            }
        }

        function renderLecturerArticles(articles) {
            const tbody = document.getElementById('lecturerArticlesBody');
            if (!articles || articles.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">No news articles found.</td></tr>`;
                return;
            }

            let html = '';
            articles.forEach(a => {
                let tagsHtml = '';
                if (a.tags && a.tags.length > 0) {
                    tagsHtml = a.tags.map(t => `<span class="badge bg-light text-dark border me-1 mb-1"><i class="bi bi-tag-fill me-1 text-primary"></i>${escapeHtml(t.tagName)}</span>`).join('');
                } else {
                    tagsHtml = '<span class="text-muted small">None</span>';
                }

                html += `
                    <tr>
                        <td class="ps-4 fw-bold text-secondary">#${a.newsArticleId}</td>
                        <td style="max-width: 320px;">
                            <div class="fw-bold text-dark text-truncate" title="${escapeHtml(a.newsTitle || '')}">${escapeHtml(a.newsTitle || '')}</div>
                            <small class="text-muted text-truncate d-block" title="${escapeHtml(a.headline || '')}">${escapeHtml(a.headline || '')}</small>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                ${escapeHtml(a.categoryName || 'Uncategorized')}
                            </span>
                        </td>
                        <td style="max-width: 180px;">${tagsHtml}</td>
                        <td><small class="text-muted">${formatDate(a.createdDate)}</small></td>
                        <td><small class="fw-semibold text-dark"><i class="bi bi-person me-1"></i>${escapeHtml(a.createdByName || 'Faculty')}</small></td>
                        <td class="text-end pe-4">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewArticleDetails('${a.newsArticleId}')">
                                <i class="bi bi-eye-fill me-1"></i> Read
                            </button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function filterLecturerNews() {
            const query = (document.getElementById('lecturerSearchInput').value || '').trim().toLowerCase();
            const catId = document.getElementById('lecturerCategoryFilter').value;

            const filtered = lecturerArticles.filter(a => {
                const matchesQuery = !query ||
                    (a.newsTitle && a.newsTitle.toLowerCase().includes(query)) ||
                    (a.headline && a.headline.toLowerCase().includes(query)) ||
                    (a.newsContent && a.newsContent.toLowerCase().includes(query));

                const matchesCat = !catId || (a.categoryId && a.categoryId.toString() === catId);

                return matchesQuery && matchesCat;
            });

            renderLecturerArticles(filtered);
        }

        function resetLecturerFilters() {
            document.getElementById('lecturerSearchInput').value = '';
            document.getElementById('lecturerCategoryFilter').value = '';
            renderLecturerArticles(lecturerArticles);
        }

        async function viewArticleDetails(id) {
            const article = lecturerArticles.find(a => a.newsArticleId === id);
            if (!article) return;

            document.getElementById('modalDetailCategory').textContent = article.categoryName || 'Uncategorized';
            document.getElementById('modalDetailTitle').textContent = article.newsTitle || '';
            document.getElementById('modalDetailAuthor').textContent = article.createdByName || 'Faculty';
            document.getElementById('modalDetailDate').textContent = formatDate(article.createdDate);
            document.getElementById('modalDetailSource').textContent = article.newsSource || 'University Official';
            document.getElementById('modalDetailHeadline').textContent = article.headline || '';
            document.getElementById('modalDetailContent').textContent = article.newsContent || '';

            const tagsContainer = document.getElementById('modalDetailTagsContainer');
            if (article.tags && article.tags.length > 0) {
                tagsContainer.innerHTML = '<span class="fw-semibold small text-muted me-2">Tags:</span>' + 
                    article.tags.map(t => `<span class="badge bg-light text-dark border me-1"><i class="bi bi-tag-fill me-1 text-primary"></i>${escapeHtml(t.tagName)}</span>`).join('');
            } else {
                tagsContainer.innerHTML = '';
            }

            // Fetch Top 3 Related Articles
            const relatedContainer = document.getElementById('modalRelatedNewsContainer');
            relatedContainer.innerHTML = '<div class="col-12 text-muted small"><div class="spinner-border spinner-border-sm me-1"></div> Finding related articles...</div>';

            try {
                const fetchFn = typeof authenticatedFetch === 'function' ? authenticatedFetch : fetch;
                let resp = await fetchFn(`${window.ANALYTICS_API_URL || 'http://localhost:5133/api/'}recommend/${id}`).catch(() => null);
                if (!resp || !resp.ok) {
                    resp = await apiFetch(`news/${id}/related`).catch(() => null);
                }
                if (resp && resp.ok) {
                    const relatedArticles = await resp.json().catch(() => []);
                    if (!relatedArticles || relatedArticles.length === 0) {
                        relatedContainer.innerHTML = '<div class="col-12 text-muted small fst-italic">No related articles found.</div>';
                    } else {
                        let relHtml = '';
                        relatedArticles.forEach(ra => {
                            relHtml += `
                                <div class="col-md-4">
                                    <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.75rem;">${escapeHtml(ra.categoryName || 'News')}</span>
                                            <small class="text-muted" style="font-size: 0.7rem;">${formatDate(ra.createdDate)}</small>
                                        </div>
                                        <h6 class="fw-bold mb-1 text-truncate" title="${escapeHtml(ra.newsTitle || '')}">${escapeHtml(ra.newsTitle || '')}</h6>
                                        <p class="small text-muted text-truncate mb-2" title="${escapeHtml(ra.headline || '')}">${escapeHtml(ra.headline || '')}</p>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-auto" onclick="viewArticleDetails('${ra.newsArticleId}')">
                                            <i class="bi bi-book-half me-1"></i> Read This
                                        </button>
                                    </div>
                                </div>
                            `;
                        });
                        relatedContainer.innerHTML = relHtml;
                    }
                }
            } catch (err) {
                relatedContainer.innerHTML = '<div class="col-12 text-muted small">Could not load recommendations.</div>';
            }

            detailModalInstance.show();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }
    </script>
}
