@page
@model FUNewsManagement_FE.Pages.Staff.ProfileModel
@{
    ViewData["Title"] = "Staff Profile & News History";
}

<div class="row g-4 mb-4">
    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4">
            <div class="mb-3">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-person-circle display-4"></i>
                </div>
            </div>
            <h4 class="fw-bold mb-1" id="profileName">Loading...</h4>
            <p class="text-muted small mb-2" id="profileEmail">email@domain.org</p>
            <div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                    <i class="bi bi-shield-check me-1"></i> Staff Member (Role 1)
                </span>
            </div>

            <!-- Password Change Section -->
            <div class="mt-4 pt-3 border-top text-start">
                <h6 class="fw-bold mb-3"><i class="bi bi-key-fill text-warning me-1"></i> Change Password</h6>
                <form id="staffPwdForm" onsubmit="event.preventDefault(); changeStaffPassword();">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Current Password</label>
                        <input type="password" id="staffCurrentPwd" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">New Password</label>
                        <input type="password" id="staffNewPwd" class="form-control form-control-sm" minlength="3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Confirm New Password</label>
                        <input type="password" id="staffConfirmPwd" class="form-control form-control-sm" required />
                    </div>
                    <div id="staffPwdAlert" class="alert alert-danger py-1 small d-none" role="alert"></div>
                    <button type="submit" class="btn btn-warning btn-sm w-100 fw-semibold" id="btnChangeStaffPwd">
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- History of Created News Articles -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-primary me-2"></i>My Authored News History
                </h5>
                <span class="badge bg-primary rounded-pill px-3 py-1" id="myArticleCountBadge">0 articles</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody id="myArticlesTableBody">
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading your articles...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentUserId = null;

        document.addEventListener('DOMContentLoaded', async () => {
            await loadProfileData();
            await loadMyArticles();
        });

        async function loadProfileData() {
            try {
                const response = await apiFetch('auth/me');
                if (response.ok) {
                    const user = await response.json();
                    currentUserId = user.accountId;
                    document.getElementById('profileName').textContent = user.accountName || 'Staff Member';
                    document.getElementById('profileEmail').textContent = user.accountEmail || '';
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function loadMyArticles() {
            const tbody = document.getElementById('myArticlesTableBody');
            tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading your articles...</td></tr>`;

            try {
                const response = await apiFetch('news?$orderby=CreatedDate desc');
                if (response.ok) {
                    const allNews = await response.json();
                    // Filter articles created by this staff
                    const myNews = allNews.filter(a => a.createdById === currentUserId);
                    document.getElementById('myArticleCountBadge').textContent = `${myNews.length} articles`;

                    if (myNews.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">You have not created any news articles yet.</td></tr>`;
                        return;
                    }

                    let html = '';
                    myNews.forEach(a => {
                        const statusBadge = a.newsStatus
                            ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>'
                            : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactive</span>';

                        html += `
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#${a.newsArticleId}</td>
                                <td style="max-width: 260px;">
                                    <span class="fw-semibold text-dark text-truncate d-block" title="${escapeHtml(a.newsTitle)}">${escapeHtml(a.newsTitle)}</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">${escapeHtml(a.categoryName || 'News')}</span>
                                </td>
                                <td>${statusBadge}</td>
                                <td><small class="text-muted">${formatDate(a.createdDate)}</small></td>
                                <td class="text-end pe-4">
                                    <a href="/Staff/Articles" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil me-1"></i> Edit in Articles
                                    </a>
                                </td>
                            </tr>
                        `;
                    });
                    tbody.innerHTML = html;
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger">Failed to load articles.</td></tr>`;
            }
        }

        async function changeStaffPassword() {
            if (!currentUserId) return;

            const cur = document.getElementById('staffCurrentPwd').value.trim();
            const newP = document.getElementById('staffNewPwd').value.trim();
            const confP = document.getElementById('staffConfirmPwd').value.trim();
            const alertEl = document.getElementById('staffPwdAlert');

            if (newP !== confP) {
                alertEl.textContent = 'Passwords do not match.';
                alertEl.classList.remove('d-none');
                return;
            }

            alertEl.classList.add('d-none');
            const btn = document.getElementById('btnChangeStaffPwd');
            btn.disabled = true;

            try {
                const resp = await apiFetch(`account/${currentUserId}/password`, {
                    method: 'PUT',
                    body: JSON.stringify({
                        currentPassword: cur,
                        newPassword: newP,
                        confirmPassword: confP
                    })
                });

                if (resp.ok) {
                    showToast('Password updated successfully!', 'success');
                    document.getElementById('staffPwdForm').reset();
                } else {
                    const err = await resp.json();
                    alertEl.textContent = err.message || 'Failed to update password.';
                    alertEl.classList.remove('d-none');
                }
            } catch (err) {
                alertEl.textContent = 'Error: ' + err.message;
                alertEl.classList.remove('d-none');
            } finally {
                btn.disabled = false;
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }
    </script>
}
