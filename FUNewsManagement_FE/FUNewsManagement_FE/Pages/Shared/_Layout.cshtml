@using System.Security.Claims
@using FUNewsManagement_FE
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews Management System v2</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- Sticky Offline Mode Banner -->
    <div id="offlineBanner" class="alert alert-warning mb-0 border-0 rounded-0 d-none text-center py-2 shadow-sm sticky-top" style="z-index: 1050;" role="alert">
        <i class="bi bi-wifi-off me-2 fw-bold text-danger"></i>
        <strong>Offline Mode Active:</strong> Core API service is currently unreachable. System is operating in read-only mode with cached snapshot data. All CRUD action buttons are disabled.
    </div>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-page="/Index">
                    <span class="badge bg-primary me-2 p-2"><i class="bi bi-newspaper fs-5"></i></span>
                    <span>FUNews<span class="text-primary">Hub v2</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active text-white fw-bold" : "")" asp-page="/Index">
                                <i class="bi bi-globe me-1"></i> Public News
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Reports" ? "active text-white fw-bold" : "")" asp-page="/Admin/Reports">
                                    <i class="bi bi-bar-chart-line-fill me-1"></i> Executive Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Accounts" ? "active text-white fw-bold" : "")" asp-page="/Admin/Accounts">
                                    <i class="bi bi-people-fill me-1"></i> Accounts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/AuditLogs" ? "active text-white fw-bold" : "")" asp-page="/Admin/AuditLogs">
                                    <i class="bi bi-journal-text me-1"></i> Audit Logs
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Articles" ? "active text-white fw-bold" : "")" asp-page="/Staff/Articles">
                                    <i class="bi bi-file-earmark-text-fill me-1"></i> Articles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Categories" ? "active text-white fw-bold" : "")" asp-page="/Staff/Categories">
                                    <i class="bi bi-folder2-open me-1"></i> Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Tags" ? "active text-white fw-bold" : "")" asp-page="/Staff/Tags">
                                    <i class="bi bi-tags-fill me-1"></i> Tags
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Profile" ? "active text-white fw-bold" : "")" asp-page="/Staff/Profile">
                                    <i class="bi bi-person-circle me-1"></i> My Profile
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Lecturer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Lecturer/Articles" ? "active text-white fw-bold" : "")" asp-page="/Lecturer/Articles">
                                    <i class="bi bi-search me-1"></i> News Explorer (Read-Only)
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Real-time SignalR Notification Center Bell -->
                        <div class="dropdown me-2 position-relative">
                            <button class="btn btn-outline-light btn-sm rounded-circle position-relative p-2" type="button" id="notifBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Real-time Notifications">
                                <i class="bi bi-bell-fill fs-6"></i>
                                <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg py-2" id="notifDropdownMenu" style="width: 350px; max-height: 420px; overflow-y: auto;">
                                <li class="dropdown-header d-flex justify-content-between align-items-center">
                                    <span class="fw-bold"><i class="bi bi-broadcast text-primary me-1"></i> SignalR Live Alerts</span>
                                    <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted" onclick="clearNotifications()">Clear</button>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <div id="notifItemsContainer">
                                    <li class="px-3 py-3 text-center text-muted small" id="noNotifMsg">No new notifications yet</li>
                                </div>
                            </ul>
                        </div>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirstValue(ClaimTypes.Role);
                            var name = User.Identity.Name ?? "User";
                            <div class="d-flex align-items-center me-2">
                                @if (role == "Admin")
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="bi bi-shield-check me-1"></i> Admin: @name
                                    </span>
                                }
                                else if (role == "Staff")
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="bi bi-person-badge me-1"></i> Staff: @name
                                    </span>
                                }
                                else if (role == "Lecturer")
                                {
                                    <span class="badge bg-info text-dark rounded-pill px-3 py-2">
                                        <i class="bi bi-mortarboard me-1"></i> Lecturer: @name
                                    </span>
                                }
                            </div>
                            <a asp-page="/Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Login" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 my-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Global Real-Time Notification & Action Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1200">
        <div id="appToast" class="toast align-items-center text-white border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 fs-6">
                    <i id="toastIcon" class="bi bi-check-circle-fill fs-5"></i>
                    <span id="toastMessage">Action completed successfully.</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center small">
            <div>
                &copy; 2026 - <strong>FUNewsManagementSystem v2</strong> - Distributed & Intelligent News Operations
            </div>
            <div>
                <span id="footerConnectionStatus" class="text-success"><i class="bi bi-check2-circle me-1"></i>APIs Connected</span>
            </div>
        </div>
    </footer>

    <!-- Libraries: jQuery, Bootstrap, Chart.js, SignalR -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        var serverJwtToken = Context.Session.GetString("JwtToken") 
            ?? User.FindFirst("JwtToken")?.Value 
            ?? "";
        var serverRefreshToken = Context.Session.GetString("refresh_token") 
            ?? User.FindFirst("RefreshToken")?.Value 
            ?? "";
    }
    <!-- Global Distributed Client Configuration & SignalR Notification Hub Listener -->
    <script>
        window.SERVER_JWT_TOKEN = "@Html.Raw(serverJwtToken)";
        window.SERVER_REFRESH_TOKEN = "@Html.Raw(serverRefreshToken)";
        if (window.SERVER_JWT_TOKEN) {
            localStorage.setItem("jwt_token", window.SERVER_JWT_TOKEN);
        } else if (!@((User.Identity?.IsAuthenticated == true).ToString().ToLower())) {
            localStorage.removeItem("jwt_token");
            localStorage.removeItem("refresh_token");
        }
        if (window.SERVER_REFRESH_TOKEN) {
            localStorage.setItem("refresh_token", window.SERVER_REFRESH_TOKEN);
        }

        window.CORE_API_URL = "http://localhost:5132/api/";
        window.ANALYTICS_API_URL = "http://localhost:5133/api/";
        window.AI_API_URL = "http://localhost:5134/api/";
        window.SIGNALR_HUB_URL = "http://localhost:5132/hubs/notifications";

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }

        function getAuthToken() {
            return window.SERVER_JWT_TOKEN || localStorage.getItem("jwt_token") || getCookie("jwt_token") || "";
        }

        function getRefreshToken() {
            return window.SERVER_REFRESH_TOKEN || localStorage.getItem("refresh_token") || getCookie("refresh_token") || "";
        }

        // Global Authenticated Fetch with Thread-Safe Token Refresh & Offline Handling
        let isRefreshingToken = false;
        let refreshSubscribers = [];

        function onTokenRefreshed(newToken) {
            refreshSubscribers.forEach(cb => cb(newToken));
            refreshSubscribers = [];
        }

        async function getTop10NewsCache() {
            // 1. Try localStorage
            const cached = localStorage.getItem("offline_cache_top10") || localStorage.getItem("offline_cache_news");
            if (cached) {
                try {
                    const parsed = JSON.parse(cached);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        return parsed;
                    }
                } catch (e) {}
            }

            // 2. Try static snapshot files: top10_news.json then news.json
            for (const file of ["/cached_snapshots/top10_news.json", "/cached_snapshots/news.json"]) {
                try {
                    const snapRes = await fetch(file);
                    if (snapRes.ok) {
                        const text = await snapRes.text();
                        const parsed = JSON.parse(text);
                        if (Array.isArray(parsed) && parsed.length > 0) {
                            localStorage.setItem("offline_cache_top10", text);
                            localStorage.setItem("offline_cache_news", text);
                            return parsed;
                        }
                    }
                } catch (e) {}
            }
            return [];
        }

        async function getCachedFallback(url) {
            const urlLower = url.toLowerCase();

            // 1. RECOMMENDATION / RELATED ARTICLES (GET /api/recommend/{id} or /news/{id}/related)
            if (urlLower.includes("/recommend") || urlLower.includes("/related")) {
                console.info(`[Offline Mode] Intercepting recommendations for: ${url}`);
                const top10 = await getTop10NewsCache();

                // Extract current article ID to avoid returning itself
                const idMatch = url.match(/(?:recommend|news)\/([^\/\?#]+)/i);
                const currentId = idMatch ? decodeURIComponent(idMatch[1]).trim().toLowerCase() : "";

                // Pick up to 3 other articles from top 10 cache
                const others = top10.filter(a => {
                    const aId = (a.newsArticleId ?? a.NewsArticleId ?? "").toString().trim().toLowerCase();
                    return !currentId || aId !== currentId;
                });

                const recommendations = (others.length > 0 ? others : top10).slice(0, 3);
                return new Response(JSON.stringify(recommendations), {
                    status: 200,
                    headers: { "Content-Type": "application/json" }
                });
            }

            // 2. SINGLE ARTICLE DETAIL (GET /api/news/{id})
            const newsDetailMatch = url.match(/(?:\/api)?\/news\/([^\/\?#]+)(?:[\?#]|$)/i);
            if (newsDetailMatch) {
                const articleId = decodeURIComponent(newsDetailMatch[1]).trim();
                const nonArticleSegments = ["my-articles", "upload-image", "search"];
                if (articleId && !nonArticleSegments.includes(articleId.toLowerCase())) {
                    console.info(`[Offline Mode] Intercepting article detail for ID: ${articleId}`);
                    const top10 = await getTop10NewsCache();

                    const found = top10.find(a => {
                        const aId = (a.newsArticleId ?? a.NewsArticleId ?? "").toString().trim().toLowerCase();
                        return aId === articleId.toLowerCase();
                    });

                    if (found) {
                        console.info(`[Offline Mode] Article '${articleId}' found in Top 10 offline cache.`);
                        return new Response(JSON.stringify(found), {
                            status: 200,
                            headers: { "Content-Type": "application/json" }
                        });
                    } else {
                        console.warn(`[Offline Mode] Article '${articleId}' not found in Top 10 offline cache.`);
                        const offlinePayload = {
                            isOffline: true,
                            message: "Bài viết này chưa được lưu ngoại tuyến. Vui lòng kết nối mạng để đọc."
                        };
                        return new Response(JSON.stringify(offlinePayload), {
                            status: 404,
                            statusText: "Not Found (Offline)",
                            headers: { "Content-Type": "application/json" }
                        });
                    }
                }
            }

            // 3. TRENDING ARTICLES (GET /api/analytics/trending)
            if (urlLower.includes("/trending")) {
                console.info(`[Offline Mode] Intercepting trending for: ${url}`);
                const top10 = await getTop10NewsCache();
                const sorted = [...top10].sort((a, b) => (b.viewCount || 0) - (a.viewCount || 0)).slice(0, 5);
                return new Response(JSON.stringify(sorted), {
                    status: 200,
                    headers: { "Content-Type": "application/json" }
                });
            }

            // 4. ARTICLE LIST (GET /api/news)
            if (urlLower.includes("/news") || urlLower.includes("newsarticle")) {
                const top10 = await getTop10NewsCache();
                return new Response(JSON.stringify(top10), {
                    status: 200,
                    headers: { "Content-Type": "application/json" }
                });
            }

            // 4. CATEGORIES, TAGS, DASHBOARD
            let cacheKey = null;
            let snapshotFile = null;

            if (urlLower.includes("/category") || urlLower.includes("/categories")) {
                cacheKey = "offline_cache_categories";
                snapshotFile = "/cached_snapshots/categories.json";
            } else if (urlLower.includes("/tag")) {
                cacheKey = "offline_cache_tags";
                snapshotFile = "/cached_snapshots/tags.json";
            } else if (urlLower.includes("/analytics/dashboard")) {
                cacheKey = "offline_cache_dashboard";
                snapshotFile = "/cached_snapshots/dashboard.json";
            }

            if (cacheKey) {
                const cached = localStorage.getItem(cacheKey);
                if (cached) {
                    console.info(`[Offline Mode] Serving ${url} from localStorage snapshot.`);
                    return new Response(cached, { status: 200, headers: { "Content-Type": "application/json" } });
                }
            }

            if (snapshotFile) {
                try {
                    const snapRes = await fetch(snapshotFile);
                    if (snapRes.ok) {
                        const text = await snapRes.text();
                        if (cacheKey) localStorage.setItem(cacheKey, text);
                        console.info(`[Offline Mode] Serving ${url} from static snapshot file: ${snapshotFile}`);
                        return new Response(text, { status: 200, headers: { "Content-Type": "application/json" } });
                    }
                } catch (e) {}
            }

            return null;
        }

        async function authenticatedFetch(url, options = {}) {
            options.headers = options.headers || {};
            const token = getAuthToken();
            if (token && !options.headers["Authorization"]) {
                options.headers["Authorization"] = `Bearer ${token}`;
            }

            const isGet = !options.method || options.method.toUpperCase() === "GET";

            try {
                let res = await fetch(url, options);

                // Check 401 Unauthorized -> Refresh Token Flow
                if (res.status === 401) {
                    const rfToken = getRefreshToken();
                    if (rfToken && token) {
                        if (!isRefreshingToken) {
                            isRefreshingToken = true;
                            try {
                                const refreshRes = await fetch(`${window.CORE_API_URL}auth/refresh`, {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ token: token, refreshToken: rfToken })
                                });

                                if (refreshRes.ok) {
                                    const refreshedData = await refreshRes.json();
                                    document.cookie = `jwt_token=${refreshedData.token}; path=/; max-age=900; SameSite=Lax`;
                                    window.SERVER_JWT_TOKEN = refreshedData.token;
                                    localStorage.setItem("jwt_token", refreshedData.token);
                                    if (refreshedData.refreshToken) {
                                        document.cookie = `refresh_token=${refreshedData.refreshToken}; path=/; max-age=604800; SameSite=Lax`;
                                        window.SERVER_REFRESH_TOKEN = refreshedData.refreshToken;
                                        localStorage.setItem("refresh_token", refreshedData.refreshToken);
                                    }
                                    isRefreshingToken = false;
                                    onTokenRefreshed(refreshedData.token);

                                    // Replay original request
                                    options.headers["Authorization"] = `Bearer ${refreshedData.token}`;
                                    return await fetch(url, options);
                                } else {
                                    isRefreshingToken = false;
                                }
                            } catch (e) {
                                isRefreshingToken = false;
                            }
                        } else {
                            // Wait for refreshing
                            return new Promise(resolve => {
                                refreshSubscribers.push(async (newToken) => {
                                    options.headers["Authorization"] = `Bearer ${newToken}`;
                                    resolve(await fetch(url, options));
                                });
                            });
                        }
                    }
                }

                // If GET was successful, save snapshot in localStorage
                if (isGet && res.ok) {
                    res.clone().text().then(text => {
                        const urlLower = url.toLowerCase();
                        if (urlLower.includes("/news") && !urlLower.includes("my-articles") && !urlLower.includes("/related")) {
                            try {
                                const parsed = JSON.parse(text);
                                if (Array.isArray(parsed)) {
                                    localStorage.setItem("offline_cache_news", text);
                                    localStorage.setItem("offline_cache_top10", text);
                                } else if (parsed && (parsed.newsArticleId || parsed.NewsArticleId)) {
                                    // Single article: update or insert into the cached top 10 array
                                    const cachedStr = localStorage.getItem("offline_cache_top10") || localStorage.getItem("offline_cache_news");
                                    let cachedList = [];
                                    if (cachedStr) {
                                        try { cachedList = JSON.parse(cachedStr); } catch (e) {}
                                    }
                                    if (Array.isArray(cachedList)) {
                                        const targetId = (parsed.newsArticleId || parsed.NewsArticleId).toString().toLowerCase();
                                        const idx = cachedList.findIndex(a => (a.newsArticleId || a.NewsArticleId || "").toString().toLowerCase() === targetId);
                                        if (idx >= 0) {
                                            cachedList[idx] = parsed;
                                        } else {
                                            cachedList.unshift(parsed);
                                            if (cachedList.length > 10) cachedList = cachedList.slice(0, 10);
                                        }
                                        const updated = JSON.stringify(cachedList);
                                        localStorage.setItem("offline_cache_top10", updated);
                                        localStorage.setItem("offline_cache_news", updated);
                                    }
                                }
                            } catch (e) {}
                        }
                        else if (urlLower.includes("/category") || urlLower.includes("/categories")) localStorage.setItem("offline_cache_categories", text);
                        else if (urlLower.includes("/tag")) localStorage.setItem("offline_cache_tags", text);
                        else if (urlLower.includes("/analytics/dashboard")) localStorage.setItem("offline_cache_dashboard", text);
                    }).catch(() => {});
                }

                setOfflineMode(false);
                return res;
            } catch (err) {
                console.warn("API request failed, activating offline resilience mode:", err);
                setOfflineMode(true);

                if (isGet) {
                    const fallbackRes = await getCachedFallback(url);
                    if (fallbackRes) {
                        return fallbackRes;
                    }
                }
                throw err;
            }
        }

        // Offline Mode Banner and CRUD Control
        function setOfflineMode(isOffline) {
            const banner = document.getElementById("offlineBanner");
            const statusIndicator = document.getElementById("footerConnectionStatus");

            if (isOffline) {
                if (banner) banner.classList.remove("d-none");
                if (statusIndicator) {
                    statusIndicator.className = "text-danger";
                    statusIndicator.innerHTML = '<i class="bi bi-x-circle me-1"></i>Offline Mode (Cache Fallback)';
                }
                // Disable all CRUD buttons across all views
                document.querySelectorAll(".btn-save, .btn-create, .btn-delete, .btn-toggle-status, #btnSaveArticle, #btnConfirmDeleteArticle, #btnSaveAccount, #btnConfirmDelete, #btnSaveCategory, #btnConfirmDeleteCategory, #btnSaveTag, #btnConfirmDeleteTag, button[onclick*='openCreate'], button[onclick*='openEdit'], button[onclick*='openDelete'], button[onclick*='duplicateArticle']").forEach(b => {
                    b.disabled = true;
                    b.classList.add("disabled");
                    b.title = "Action disabled in Offline Mode";
                });
            } else {
                if (banner) banner.classList.add("d-none");
                if (statusIndicator) {
                    statusIndicator.className = "text-success";
                    statusIndicator.innerHTML = '<i class="bi bi-check2-circle me-1"></i>APIs Connected';
                }
                document.querySelectorAll(".btn-save, .btn-create, .btn-delete, .btn-toggle-status, #btnSaveArticle, #btnConfirmDeleteArticle, #btnSaveAccount, #btnConfirmDelete, #btnSaveCategory, #btnConfirmDeleteCategory, #btnSaveTag, #btnConfirmDeleteTag, button[onclick*='openCreate'], button[onclick*='openEdit'], button[onclick*='openDelete'], button[onclick*='duplicateArticle']").forEach(b => {
                    b.disabled = false;
                    b.classList.remove("disabled");
                    b.removeAttribute("title");
                });
            }
        }

        // Notification Center State (Retain up to 10 notifications)
        let notificationsList = JSON.parse(localStorage.getItem("funews_notifications") || "[]");

        function updateNotifDropdown() {
            const container = document.getElementById("notifItemsContainer");
            const badge = document.getElementById("notifBadge");

            if (!container || !badge) return;

            const unreadCount = notificationsList.filter(n => !n.isRead).length;

            if (unreadCount === 0) {
                badge.classList.add("d-none");
                badge.innerText = "0";
            } else {
                badge.classList.remove("d-none");
                badge.innerText = unreadCount;
            }

            if (notificationsList.length === 0) {
                container.innerHTML = `<li class="px-3 py-3 text-center text-muted small" id="noNotifMsg">No new notifications yet</li>`;
            } else {
                let html = "";
                notificationsList.slice(0, 10).forEach(n => {
                    const linkUrl = n.articleId ? `/NewsDetail?id=${encodeURIComponent(n.articleId)}` : '#';
                    const unreadBadge = !n.isRead ? '<span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.65rem;">New</span>' : '';
                    const titleClass = !n.isRead ? 'fw-bold text-dark' : 'text-muted';
                    html += `
                        <li class="border-bottom hover-bg ${n.isRead ? 'bg-light' : ''}">
                            <a href="${linkUrl}" onclick="markNotificationAsRead('${n.articleId}')" class="d-flex align-items-start gap-2 px-3 py-2 text-decoration-none text-dark">
                                <div class="bg-primary text-white rounded-circle p-2 mt-1 flex-shrink-0">
                                    <i class="bi bi-newspaper fs-6"></i>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="small text-truncate ${titleClass}" style="max-width: 220px;">${escapeHtml(n.title)}</div>
                                        ${unreadBadge}
                                    </div>
                                    <small class="text-muted d-block">${escapeHtml(n.categoryName || 'News')} • by ${escapeHtml(n.authorName || 'Staff')}</small>
                                    <small class="text-secondary font-monospace" style="font-size: 0.72rem;">${new Date(n.time).toLocaleTimeString()}</small>
                                </div>
                            </a>
                        </li>
                    `;
                });
                container.innerHTML = html;
            }
        }

        function markNotificationAsRead(articleId) {
            if (!articleId) return;
            const notif = notificationsList.find(n => n.articleId === articleId);
            if (notif && !notif.isRead) {
                notif.isRead = true;
                localStorage.setItem("funews_notifications", JSON.stringify(notificationsList));
                updateNotifDropdown();
            }
        }

        function clearNotifications() {
            notificationsList = [];
            localStorage.setItem("funews_notifications", "[]");
            updateNotifDropdown();
        }

        function addNotification(item) {
            item.isRead = false;
            notificationsList.unshift(item);
            if (notificationsList.length > 10) {
                notificationsList = notificationsList.slice(0, 10);
            }
            localStorage.setItem("funews_notifications", JSON.stringify(notificationsList));
            updateNotifDropdown();
        }

        // SignalR Real-Time Hub Connection
        let signalrConnection = null;

        function startSignalRConnection() {
            if (typeof signalR === "undefined") return;

            signalrConnection = new signalR.HubConnectionBuilder()
                .withUrl(window.SIGNALR_HUB_URL, {
                    accessTokenFactory: () => {
                        const token = getAuthToken();
                        return token ? token : null;
                    }
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Information)
                .build();

            signalrConnection.on("ReceiveNewArticleNotification", function (data) {
                console.log("Real-time new article notification received:", data);

                const notif = {
                    articleId: data.articleId,
                    title: data.title || "New Article Published",
                    headline: data.headline || "",
                    categoryName: data.categoryName || "General",
                    authorName: data.authorName || "Staff",
                    time: data.createdAt || data.createdDate || new Date()
                };

                addNotification(notif);
                const targetUrl = notif.articleId ? `/NewsDetail?id=${encodeURIComponent(notif.articleId)}` : null;
                showToast(`🔔 New Article: "${notif.title}" (${notif.categoryName}) — Click to view`, true, targetUrl, notif.articleId);
            });

            // Real-Time View Count & Trending Updates Listener
            signalrConnection.on("ReceiveViewCountUpdated", function (data) {
                console.log("Real-time view count updated:", data);

                // 1. Cập nhật số view nếu đang ở trang chi tiết bài viết này
                const viewEl = document.getElementById("viewCountText");
                const urlParams = new URLSearchParams(window.location.search);
                const currentArticleId = urlParams.get('id');
                if (viewEl && currentArticleId && currentArticleId.toString() === (data.articleId || '').toString()) {
                    viewEl.textContent = (data.viewCount || 0).toLocaleString();
                    viewEl.classList.add('text-success', 'fw-bold');
                    setTimeout(() => viewEl.classList.remove('text-success', 'fw-bold'), 1500);
                }

                // 2. Cập nhật badge view count trên bất kỳ thẻ bài viết nào có id "view-count-{articleId}"
                const badgeEl = document.getElementById(`view-count-${data.articleId}`);
                if (badgeEl) {
                    badgeEl.textContent = (data.viewCount || 0).toLocaleString();
                }

                // 3. Dispatch Custom Event toàn cục để các trang con (Reports, Index) cập nhật bảng Trending
                window.dispatchEvent(new CustomEvent("funews:viewUpdated", { detail: data }));
            });

            signalrConnection.start()
                .then(() => {
                    console.log("Connected to SignalR Notification Hub at:", window.SIGNALR_HUB_URL);
                    setOfflineMode(false);
                })
                .catch(err => {
                    console.warn("Could not connect to SignalR hub (backend might be starting):", err.message);
                });

            signalrConnection.onreconnecting(() => {
                console.warn("SignalR reconnecting...");
            });

            signalrConnection.onreconnected(() => {
                console.log("SignalR reconnected successfully!");
                setOfflineMode(false);
            });

            signalrConnection.onclose(() => {
                console.warn("SignalR connection closed.");
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateNotifDropdown();
            startSignalRConnection();
        });

        function showToast(message, isSuccess = true, onClickUrl = null, onClickArticleId = null) {
            const toastEl = document.getElementById("appToast");
            const toastMsg = document.getElementById("toastMessage");
            const toastIcon = document.getElementById("toastIcon");

            if (!toastEl) return;

            toastEl.className = `toast align-items-center text-white border-0 shadow-lg ${isSuccess ? "bg-success" : "bg-danger"}`;
            toastIcon.className = `bi ${isSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill"} fs-5`;
            toastMsg.innerText = message;

            if (onClickUrl) {
                toastEl.style.cursor = "pointer";
                toastEl.title = "Click to view article";
                toastEl.onclick = () => {
                    if (onClickArticleId) {
                        markNotificationAsRead(onClickArticleId);
                    }
                    window.location.href = onClickUrl;
                };
            } else {
                toastEl.style.cursor = "default";
                toastEl.removeAttribute("title");
                toastEl.onclick = null;
            }

            const toast = new bootstrap.Toast(toastEl, { delay: 6000 });
            toast.show();
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>