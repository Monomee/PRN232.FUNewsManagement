@page
@model HoangNV_SE1930_A01_FE.Pages.Staff.ArticlesModel
@{
    ViewData["Title"] = "News Articles Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-richtext text-primary me-2"></i>News Articles Management</h2>
        <p class="text-muted mb-0">Publish, update, duplicate, and organize university news content (Staff only).</p>
    </div>
    <button type="button" class="btn btn-primary px-3 shadow-sm" onclick="openCreateArticleModal()">
        <i class="bi bi-file-earmark-plus me-1"></i> Create New Article
    </button>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="articleSearchInput" class="form-control border-start-0" placeholder="Search title, headline, author..." onkeyup="filterArticles()" />
                </div>
            </div>
            <div class="col-md-3">
                <select id="categoryFilter" class="form-select" onchange="filterArticles()">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="articleStatusFilter" class="form-select" onchange="filterArticles()">
                    <option value="">-- All Status --</option>
                    <option value="active">Active (Published)</option>
                    <option value="inactive">Inactive (Draft)</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetArticleFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Articles Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="articlesTable">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Title & Headline</th>
                    <th>Category</th>
                    <th>Tags</th>
                    <th>Status</th>
                    <th>Author & Date</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody id="articlesTableBody">
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div> Loading news articles...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Create / Edit Article Modal -->
<div class="modal fade" id="articleModal" tabindex="-1" aria-labelledby="articleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="articleModalLabel"><i class="bi bi-file-earmark-plus me-2"></i>Create News Article</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="articleForm">
                    <input type="hidden" id="modalArticleId" value="" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">News Title <span class="text-danger">*</span></label>
                            <input type="text" id="modalArticleTitle" class="form-control" required placeholder="Enter compelling news title" maxlength="400" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select id="modalArticleCategory" class="form-select" required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Headline <span class="text-danger">*</span></label>
                        <input type="text" id="modalArticleHeadline" class="form-control" required placeholder="Short summary headline" maxlength="150" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">News Content <span class="text-danger">*</span></label>
                        <textarea id="modalArticleContent" class="form-control" rows="6" required placeholder="Full news article content..." maxlength="4000"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">News Source</label>
                            <input type="text" id="modalArticleSource" class="form-control" placeholder="e.g. University Press / Faculty" maxlength="400" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-4">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" role="switch" id="modalArticleStatus" checked />
                                <label class="form-check-label fs-6 fw-semibold ms-2" for="modalArticleStatus">Published (Active)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Tags Checkboxes -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assign Tags / Topics</label>
                        <div class="p-3 bg-light rounded-3 border" id="tagsCheckboxContainer" style="max-height: 150px; overflow-y: auto;">
                            <span class="text-muted small">Loading tags...</span>
                        </div>
                    </div>

                    <div id="articleModalAlert" class="alert alert-danger py-2 d-none" role="alert"></div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveArticle" onclick="saveArticle()">
                    <span id="saveArticleSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status"></span>
                    Save Article
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Article Confirmation Modal -->
<div class="modal fade" id="deleteArticleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-trash3-fill me-2"></i>Delete News Article</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-exclamation-triangle text-danger display-4 mb-3 d-block"></i>
                <h5 class="fw-bold mb-2">Delete this Article?</h5>
                <p class="text-muted mb-2">Are you sure you want to delete:</p>
                <p class="fw-bold fs-6 text-dark" id="deleteArticleTitle"></p>
                <small class="text-muted">Associated tags in NewsTag junction will also be unlinked.</small>
            </div>
            <div class="modal-footer bg-light justify-content-center">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDeleteArticle" onclick="confirmDeleteArticle()">
                    <span id="deleteArticleSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status"></span>
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allArticles = [];
        let allCategories = [];
        let allTags = [];
        let articleModalInstance = null;
        let deleteArticleModalInstance = null;
        let selectedArticleDeleteId = null;

        document.addEventListener('DOMContentLoaded', async () => {
            articleModalInstance = new bootstrap.Modal(document.getElementById('articleModal'));
            deleteArticleModalInstance = new bootstrap.Modal(document.getElementById('deleteArticleModal'));
            await Promise.all([loadCategories(), loadTags()]);
            await loadArticles();
        });

        async function loadCategories() {
            try {
                const response = await apiFetch('category?$orderby=CategoryName asc');
                if (response.ok) {
                    allCategories = await response.json();
                    const filterSelect = document.getElementById('categoryFilter');
                    const modalSelect = document.getElementById('modalArticleCategory');

                    filterSelect.innerHTML = '<option value="">-- All Categories --</option>';
                    modalSelect.innerHTML = '<option value="">-- Select Category --</option>';

                    allCategories.forEach(c => {
                        const opt1 = document.createElement('option');
                        opt1.value = c.categoryId;
                        opt1.textContent = c.categoryName;
                        filterSelect.appendChild(opt1);

                        const opt2 = document.createElement('option');
                        opt2.value = c.categoryId;
                        opt2.textContent = c.categoryName;
                        modalSelect.appendChild(opt2);
                    });
                }
            } catch (err) {
                console.error('Error loading categories:', err);
            }
        }

        async function loadTags() {
            try {
                const response = await apiFetch('tag?$orderby=TagName asc');
                if (response.ok) {
                    allTags = await response.json();
                    renderTagsCheckboxList();
                }
            } catch (err) {
                console.error('Error loading tags:', err);
            }
        }

        function renderTagsCheckboxList(selectedTagIds = []) {
            const container = document.getElementById('tagsCheckboxContainer');
            if (!allTags || allTags.length === 0) {
                container.innerHTML = '<span class="text-muted small">No tags created yet.</span>';
                return;
            }

            let html = '<div class="row g-2">';
            allTags.forEach(t => {
                const isChecked = selectedTagIds.includes(t.tagId) ? 'checked' : '';
                html += `
                    <div class="col-md-4 col-sm-6">
                        <div class="form-check">
                            <input class="form-check-input tag-checkbox" type="checkbox" value="${t.tagId}" id="tagCheck_${t.tagId}" ${isChecked} />
                            <label class="form-check-label small" for="tagCheck_${t.tagId}">${escapeHtml(t.tagName)}</label>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        async function loadArticles() {
            const tbody = document.getElementById('articlesTableBody');
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading news articles...</td></tr>`;

            try {
                const response = await apiFetch('news/my-articles?$orderby=CreatedDate desc');
                if (response.ok) {
                    allArticles = await response.json();
                    renderArticles(allArticles);
                } else {
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Failed to load articles. Status: ${response.status}</td></tr>`;
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Error connecting to server. Please check Backend API.</td></tr>`;
            }
        }

        function renderArticles(articles) {
            const tbody = document.getElementById('articlesTableBody');
            if (!articles || articles.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">No articles found.</td></tr>`;
                return;
            }

            let html = '';
            articles.forEach(a => {
                const statusBadge = a.newsStatus
                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle me-1"></i>Active</span>'
                    : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-dash-circle me-1"></i>Inactive</span>';

                let tagBadges = '';
                if (a.tags && a.tags.length > 0) {
                    tagBadges = a.tags.map(t => `<span class="badge bg-light text-dark border me-1 mb-1"><i class="bi bi-tag-fill me-1 text-primary"></i>${escapeHtml(t.tagName)}</span>`).join('');
                } else {
                    tagBadges = '<span class="text-muted small">No tags</span>';
                }

                const createdInfo = `<div class="small fw-semibold text-dark"><i class="bi bi-person me-1"></i>${escapeHtml(a.createdByName || 'Staff')}</div><small class="text-muted">${formatDate(a.createdDate)}</small>`;

                html += `
                    <tr>
                        <td class="ps-4 fw-bold text-secondary">#${a.newsArticleId}</td>
                        <td style="max-width: 320px;">
                            <div class="fw-bold text-dark text-truncate" title="${escapeHtml(a.newsTitle || '')}">${escapeHtml(a.newsTitle || '')}</div>
                            <small class="text-muted text-truncate d-block" title="${escapeHtml(a.headline || '')}">${escapeHtml(a.headline || '')}</small>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                ${escapeHtml(a.categoryName || 'Uncategorized')}
                            </span>
                        </td>
                        <td style="max-width: 180px;">${tagBadges}</td>
                        <td>${statusBadge}</td>
                        <td>${createdInfo}</td>
                        <td class="text-end pe-4 text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Edit Article" onclick="openEditArticleModal('${a.newsArticleId}')">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info me-1" title="Duplicate Article" onclick="duplicateArticle('${a.newsArticleId}')">
                                <i class="bi bi-copy"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Article" onclick="openDeleteArticleModal('${a.newsArticleId}', '${escapeHtml(a.newsTitle || '')}')">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function filterArticles() {
            const query = (document.getElementById('articleSearchInput').value || '').trim().toLowerCase();
            const catId = document.getElementById('categoryFilter').value;
            const status = document.getElementById('articleStatusFilter').value;

            const filtered = allArticles.filter(a => {
                const matchesQuery = !query ||
                    (a.newsTitle && a.newsTitle.toLowerCase().includes(query)) ||
                    (a.headline && a.headline.toLowerCase().includes(query)) ||
                    (a.createdByName && a.createdByName.toLowerCase().includes(query)) ||
                    (a.newsSource && a.newsSource.toLowerCase().includes(query));

                const matchesCategory = !catId || (a.categoryId && a.categoryId.toString() === catId);

                let matchesStatus = true;
                if (status === 'active') matchesStatus = a.newsStatus === true;
                if (status === 'inactive') matchesStatus = a.newsStatus === false;

                return matchesQuery && matchesCategory && matchesStatus;
            });

            renderArticles(filtered);
        }

        function resetArticleFilters() {
            document.getElementById('articleSearchInput').value = '';
            document.getElementById('categoryFilter').value = '';
            document.getElementById('articleStatusFilter').value = '';
            renderArticles(allArticles);
        }

        function openCreateArticleModal() {
            document.getElementById('articleModalLabel').innerHTML = '<i class="bi bi-file-earmark-plus me-2"></i>Create News Article';
            document.getElementById('modalArticleId').value = '';
            document.getElementById('modalArticleTitle').value = '';
            document.getElementById('modalArticleHeadline').value = '';
            document.getElementById('modalArticleContent').value = '';
            document.getElementById('modalArticleSource').value = '';
            document.getElementById('modalArticleCategory').value = '';
            document.getElementById('modalArticleStatus').checked = true;
            renderTagsCheckboxList([]);
            document.getElementById('articleModalAlert').classList.add('d-none');
            articleModalInstance.show();
        }

        function openEditArticleModal(id) {
            const article = allArticles.find(a => a.newsArticleId === id);
            if (!article) return;

            document.getElementById('articleModalLabel').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Edit News Article';
            document.getElementById('modalArticleId').value = article.newsArticleId;
            document.getElementById('modalArticleTitle').value = article.newsTitle || '';
            document.getElementById('modalArticleHeadline').value = article.headline || '';
            document.getElementById('modalArticleContent').value = article.newsContent || '';
            document.getElementById('modalArticleSource').value = article.newsSource || '';
            document.getElementById('modalArticleCategory').value = article.categoryId || '';
            document.getElementById('modalArticleStatus').checked = article.newsStatus === true;

            const selectedTagIds = (article.tags || []).map(t => t.tagId);
            renderTagsCheckboxList(selectedTagIds);

            document.getElementById('articleModalAlert').classList.add('d-none');
            articleModalInstance.show();
        }

        async function saveArticle() {
            const id = document.getElementById('modalArticleId').value;
            const title = document.getElementById('modalArticleTitle').value.trim();
            const headline = document.getElementById('modalArticleHeadline').value.trim();
            const content = document.getElementById('modalArticleContent').value.trim();
            const source = document.getElementById('modalArticleSource').value.trim();
            const catIdVal = document.getElementById('modalArticleCategory').value;
            const status = document.getElementById('modalArticleStatus').checked;
            const alertEl = document.getElementById('articleModalAlert');

            if (!title || !headline || !content || !catIdVal) {
                alertEl.textContent = 'Please fill in Title, Headline, Category, and Content.';
                alertEl.classList.remove('d-none');
                return;
            }

            // Collect selected tags
            const selectedTagIds = [];
            document.querySelectorAll('.tag-checkbox:checked').forEach(cb => {
                selectedTagIds.push(parseInt(cb.value, 10));
            });

            const btn = document.getElementById('btnSaveArticle');
            const spinner = document.getElementById('saveArticleSpinner');
            btn.disabled = true;
            spinner.classList.remove('d-none');
            alertEl.classList.add('d-none');

            try {
                let response;
                if (!id) {
                    // Create
                    response = await apiFetch('news', {
                        method: 'POST',
                        body: JSON.stringify({
                            newsTitle: title,
                            headline: headline,
                            newsContent: content,
                            newsSource: source || null,
                            categoryId: parseInt(catIdVal, 10),
                            newsStatus: status,
                            tagIds: selectedTagIds
                        })
                    });
                } else {
                    // Update
                    response = await apiFetch(`news/${id}`, {
                        method: 'PUT',
                        body: JSON.stringify({
                            newsTitle: title,
                            headline: headline,
                            newsContent: content,
                            newsSource: source || null,
                            categoryId: parseInt(catIdVal, 10),
                            newsStatus: status,
                            tagIds: selectedTagIds
                        })
                    });
                }

                if (response.ok) {
                    articleModalInstance.hide();
                    showToast(!id ? 'News article published successfully!' : 'News article updated successfully!', 'success');
                    await loadArticles();
                } else {
                    const err = await response.json();
                    alertEl.textContent = err.message || 'An error occurred while saving article.';
                    alertEl.classList.remove('d-none');
                }
            } catch (err) {
                alertEl.textContent = 'Error: ' + err.message;
                alertEl.classList.remove('d-none');
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        async function duplicateArticle(id) {
            if (!confirm('Duplicate this article? A new copy will be created.')) return;

            try {
                const response = await apiFetch(`news/${id}/duplicate`, {
                    method: 'POST'
                });

                if (response.ok) {
                    const duplicated = await response.json();
                    showToast(`Article duplicated successfully as #${duplicated.newsArticleId}!`, 'success');
                    await loadArticles();
                } else {
                    const err = await response.json();
                    showToast(err.message || 'Failed to duplicate article.', 'danger');
                }
            } catch (err) {
                showToast('Error: ' + err.message, 'danger');
            }
        }

        function openDeleteArticleModal(id, title) {
            selectedArticleDeleteId = id;
            document.getElementById('deleteArticleTitle').textContent = `"${title}" (#${id})`;
            deleteArticleModalInstance.show();
        }

        async function confirmDeleteArticle() {
            if (!selectedArticleDeleteId) return;

            const btn = document.getElementById('btnConfirmDeleteArticle');
            const spinner = document.getElementById('deleteArticleSpinner');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const response = await apiFetch(`news/${selectedArticleDeleteId}`, {
                    method: 'DELETE'
                });

                deleteArticleModalInstance.hide();

                if (response.ok || response.status === 204) {
                    showToast('Article deleted successfully!', 'success');
                    await loadArticles();
                } else {
                    const err = await response.json();
                    showToast(err.message || 'Failed to delete article.', 'danger');
                }
            } catch (err) {
                deleteArticleModalInstance.hide();
                showToast('Error: ' + err.message, 'danger');
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
                selectedArticleDeleteId = null;
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }
    </script>
}
